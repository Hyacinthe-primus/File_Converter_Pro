QDialog { background-color: #f8f9fa; }

QLabel { color: #212529; }

QLabel#AdvConvTitle {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 4px;
}

QLabel#AdvConvSubtitle {
    font-size: 12px;
    color: #888;
    margin-bottom: 10px;
}

QGroupBox {
    color: #495057;
    border: 1px solid #dee2e6;
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #495057;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QProgressBar {
    border: 1px solid #dee2e6;
    border-radius: 6px;
    background: #f1f3f5;
    color: #212529;
    text-align: center;
}
QProgressBar::chunk {
    background: rgba(110,190,255,0.85);
    border-radius: 5px;
}

QTextEdit {
    background: #ffffff;
    color: #212529;
    border: 1px solid #dee2e6;
    border-radius: 6px;
}
QTextEdit:focus { border: 1px solid #a78bfa; }

QTextEdit#AdvConvLog {
    font-family: 'Cascadia Code', 'JetBrains Mono', 'Segoe UI', sans-serif;
    font-size: 11px;
}

QTabWidget::pane {
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 10px;
    background-color: rgba(0,0,0,0.02);
}

QTabBar::tab {
    background: rgba(0,0,0,0.05);
    color: rgba(0,0,0,0.45);
    border: 1px solid rgba(0,0,0,0.12);
    padding: 10px 22px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Segoe UI', 'SF Pro Display', Arial, sans-serif;
}

QTabBar::tab:selected {
    background: rgba(110,190,255,0.18);
    color: rgb(110,190,255);
    border: 1px solid rgba(110,190,255,0.35);
}

QTabBar::tab:hover:!selected {
    background: rgba(0,0,0,0.08);
    color: rgba(0,0,0,0.72);
}

QTabWidget[active_tab="images"] QTabBar::tab:selected {
    background: rgba(32,200,170,0.18);
    color: rgb(32,200,170);
    border: 1px solid rgba(32,200,170,0.35);
}

QTabWidget[active_tab="audio_video"] QTabBar::tab:selected {
    background: rgba(255,140,60,0.18);
    color: rgb(255,140,60);
    border: 1px solid rgba(255,140,60,0.35);
}

QPushButton[tab_type="documents"] {
    background: rgba(110,190,255,0.15); color: rgb(110,190,255);
    border: 1px solid rgba(110,190,255,0.30); border-radius: 8px;
    font-weight: bold; font-size: 13px;
    font-family: 'Segoe UI', 'SF Pro Display', Arial, sans-serif;
    letter-spacing: 0.3px;
}
QPushButton[tab_type="documents"]:hover   { background: rgba(110,190,255,0.26); }
QPushButton[tab_type="documents"]:pressed { background: rgba(110,190,255,0.38); }

QPushButton[tab_type="images"] {
    background: rgba(32,200,170,0.15); color: rgb(32,200,170);
    border: 1px solid rgba(32,200,170,0.30); border-radius: 8px;
    font-weight: bold; font-size: 13px;
    font-family: 'Segoe UI', 'SF Pro Display', Arial, sans-serif;
    letter-spacing: 0.3px;
}
QPushButton[tab_type="images"]:hover   { background: rgba(32,200,170,0.26); }
QPushButton[tab_type="images"]:pressed { background: rgba(32,200,170,0.38); }

QPushButton[tab_type="audio_video"] {
    background: rgba(255,140,60,0.15); color: rgb(255,140,60);
    border: 1px solid rgba(255,140,60,0.30); border-radius: 8px;
    font-weight: bold; font-size: 13px;
    font-family: 'Segoe UI', 'SF Pro Display', Arial, sans-serif;
    letter-spacing: 0.3px;
}
QPushButton[tab_type="audio_video"]:hover   { background: rgba(255,140,60,0.26); }
QPushButton[tab_type="audio_video"]:pressed { background: rgba(255,140,60,0.38); }
