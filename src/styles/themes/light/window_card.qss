/* File Converter Pro - Quick Convert card (light theme) */

#card {
    background: rgba(255, 255, 255, 0.97);
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.10);
}
QLabel { color: rgba(30, 35, 50, 0.90); font-family: 'Segoe UI'; }
#title    { font-size: 13px; font-weight: 700; color: rgba(30, 35, 50, 0.95); }
#fileList { font-size: 11px; color: rgba(30, 35, 50, 0.55); }
#separator { background: rgba(0, 0, 0, 0.12); min-height: 1px; max-height: 1px; border: none; }
QComboBox {
    background: rgba(0, 0, 0, 0.04);
    color: #1e2332;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 7px;
    padding: 7px 10px; font-size: 12px; font-family: 'Segoe UI';
    min-height: 16px;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
    background: #ffffff; color: #1e2332;
    selection-background-color: rgb(41,128,185); selection-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.14); outline: none;
}
QComboBox QAbstractItemView::item { color: #1e2332; padding: 4px 6px; }
QComboBox QAbstractItemView::item:selected { background: rgb(41,128,185); color: #ffffff; }
QPushButton#convertBtn {
    background: rgba(52, 152, 219, 0.16);
    color: rgb(41, 128, 185);
    border: 1px solid rgba(52, 152, 219, 0.35);
    border-radius: 8px;
    padding: 9px 0; font-weight: 700;
    font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#convertBtn:hover    { background: rgba(52, 152, 219, 0.26); }
QPushButton#convertBtn:disabled {
    background: rgba(0, 0, 0, 0.05);
    color: rgba(30, 35, 50, 0.25);
    border-color: rgba(0, 0, 0, 0.07);
}
QPushButton#cancelBtn {
    background: rgba(0, 0, 0, 0.04);
    color: rgba(30, 35, 50, 0.55);
    border: 1px solid rgba(0, 0, 0, 0.10);
    border-radius: 8px;
    padding: 9px 0; font-size: 12px; font-family: 'Segoe UI';
}
QPushButton#cancelBtn:hover {
    background: rgba(0, 0, 0, 0.08);
    color: rgba(30, 35, 50, 0.80);
    border-color: rgba(0, 0, 0, 0.20);
}
QProgressBar {
    background: rgba(0, 0, 0, 0.08);
    border-radius: 3px;
    min-height: 5px; max-height: 5px; border: none;
}
QProgressBar::chunk { background: rgba(52, 152, 219, 0.70); border-radius: 3px; }
#statusOk  { font-size: 11px; color: rgb(22, 160, 133); font-family: 'Segoe UI'; }
#statusErr { font-size: 11px; color: rgb(231, 76, 60); font-family: 'Segoe UI'; }
#conversionLabel {
    font-size: 12px; font-weight: 600;
    color: rgb(41, 128, 185);
    font-family: 'Segoe UI';
}
