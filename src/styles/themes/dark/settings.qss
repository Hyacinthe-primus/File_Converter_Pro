QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}

QGroupBox {
    background: #161b27;
    border: 1px solid #2d3748;
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 10px;
    font-size: 11px;
    font-weight: 600;
    color: #8b949e;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #8b949e;
}

QLabel { color: #e6edf3; background: transparent; }

QLabel#SettingsLabel {
    font-size: 12px;
    color: #8b949e;
}

QLabel#SettingsActiveLabel {
    font-weight: bold;
    font-size: 13px;
    color: #3fb950;
}

QLabel#SettingsHint {
    color: #8b949e;
    font-size: 10px;
    font-style: italic;
    background: transparent;
}

QWidget#SettingsAutomationTab,
QWidget#SettingsThemeTab,
QWidget#SettingsLanguageTab {
    background-color: #0d1117;
}

QFrame#SettingsCard {
    border: 1px solid #30363d;
    border-radius: 7px;
    background-color: #161b22;
}

QLabel#SettingsStatusDot {
    font-size: 14px;
    border: none;
}

QLabel#SettingsCardName {
    font-weight: bold;
    font-size: 12px;
    color: #c9d1d9;
    border: none;
}

QLabel#SettingsCardPath {
    font-size: 10px;
    color: #8b949e;
    border: none;
}

QLabel#SettingsEmptyLabel {
    color: #8b949e;
    font-size: 11px;
    font-style: italic;
}

QWidget#SettingsScrollInner {
    background-color: #161b22;
}

QGroupBox#SettingsGroup {
    color: #8b949e;
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    font-size: 11px;
    font-weight: 600;
}
QGroupBox#SettingsGroup::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #8b949e;
}

QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 7px;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 16px;
}
QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
    color: #e6edf3;
}
QPushButton:pressed { background-color: #161b22; }
QPushButton:disabled { background-color: #161b22; color: #484f58; border-color: #21262d; }

QCheckBox {
    color: #e6edf3;
    spacing: 8px;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #484f58;
    border-radius: 4px;
    background-color: #0d1117;
}
QCheckBox::indicator:hover { border-color: #388bfd; }
QCheckBox::indicator:checked { background-color: #388bfd; border-color: #388bfd; }

QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background: #1e2535;
    width: 8px;
    margin: 0;
    border-radius: 4px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #3d4f6a;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: #5a7090; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: #1e2535;
    height: 8px;
    border-radius: 4px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #3d4f6a;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background: #5a7090; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QComboBox {
    background: #1a2236;
    color: #e0e8f0;
    border: 1px solid #2d3748;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    min-width: 140px;
}
QComboBox:hover { border-color: #4dabf7; }
QComboBox:focus { border-color: #a78bfa; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #1a2236;
    color: #e0e8f0;
    border: 1px solid #2d3748;
    border-radius: 8px;
    selection-background-color: #2d3e56;
    selection-color: #c4b5fd;
}

QListWidget {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    font-size: 13px;
    outline: none;
}
QListWidget::item {
    padding: 9px 12px;
    border-bottom: 1px solid #21262d;
}
QListWidget::item:hover { background-color: #1f2937; }
QListWidget::item:selected {
    background-color: #388bfd22;
    color: #79c0ff;
    border-left: 3px solid #388bfd;
    font-weight: 600;
}

/* Settings dialog: language/theme list cards */

QFrame#SettingsListCard {
    border: 2px solid #30363d;
    border-radius: 8px;
    background-color: #1c2333;
    padding: 2px;
}
QFrame#SettingsListCard[active="true"] {
    border: 2px solid #3fb950;
    background-color: #0f2a1e;
}

QLabel#SettingsListBadge {
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
    font-weight: bold;
    border: none;
}
QLabel#SettingsListBadge[kind="active"] { background-color: #3fb950; color: #ffffff; }
QLabel#SettingsListBadge[kind="builtin"] { background-color: #388bfd; color: #ffffff; }
QLabel#SettingsListBadge[kind="external"] { background-color: #f0a030; color: #ffffff; }

QLabel#SettingsListName {
    font-weight: bold;
    font-size: 13px;
    color: #e6edf3;
    border: none;
    background: transparent;
}

QLabel#SettingsListMeta {
    color: #8b949e;
    font-size: 10px;
    border: none;
    background: transparent;
}

QLabel#SettingsListPreview {
    border: 1px solid #30363d;
    border-radius: 6px;
    background-color: #1c2333;
}

QPushButton#SettingsApplyBtn {
    background-color: #1f3a6e;
    color: #79c0ff;
    border: 1px solid #388bfd;
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#SettingsApplyBtn:hover { background-color: #388bfd; color: #ffffff; }
QPushButton#SettingsApplyBtn:pressed { background-color: #1158c7; color: #ffffff; }

QPushButton#SettingsRemoveBtn {
    background-color: #3d1a1a;
    color: #f85149;
    border: 1px solid #6e1a1a;
    padding: 4px;
    border-radius: 5px;
    font-size: 13px;
}
QPushButton#SettingsRemoveBtn:hover { background-color: #f85149; color: #ffffff; }

/* Settings dialog: OK / Cancel / Restore / Browse buttons */

QPushButton#SettingsOkBtn {
    background-color: #10B981; color: #ffffff; border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#SettingsOkBtn:hover { background-color: #059669; }
QPushButton#SettingsOkBtn:pressed { background-color: #047857; }

QPushButton#SettingsBrowseBtn {
    background-color: #374151; color: #ffffff; border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#SettingsBrowseBtn:hover { background-color: #4B5563; }
QPushButton#SettingsBrowseBtn:pressed { background-color: #1F2937; }

QPushButton#SettingsCancelBtn {
    background-color: transparent; color: #8b949e; border: 1px solid #30363d;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#SettingsCancelBtn:hover { background-color: #21262d; color: #e6edf3; border-color: #8b949e; }
QPushButton#SettingsCancelBtn:pressed { background-color: #161b22; color: #e6edf3; }

QPushButton#SettingsRestoreBtn {
    background-color: transparent; color: #f85149; border: 1px solid #f85149;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#SettingsRestoreBtn:hover { background-color: #3d1a1a; border-color: #ff7b72; color: #ff7b72; }
QPushButton#SettingsRestoreBtn:pressed { background-color: #2d1212; color: #ffa198; border-color: #ffa198; }

/* Settings dialog: install / import buttons */

QPushButton#SettingsImportBtn {
    background-color: #1f3a6e; color: #79c0ff; border: 1px solid #388bfd;
    padding: 8px 16px; border-radius: 6px; font-weight: bold;
}
QPushButton#SettingsImportBtn:hover { background-color: #388bfd; color: #ffffff; }
QPushButton#SettingsImportBtn:pressed { background-color: #1158c7; color: #ffffff; }

/* Settings dialog: automation action buttons */
QPushButton#SettingsAutomationOpenBtn {
    background-color: #10B981; color: #ffffff; border: none;
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#SettingsAutomationOpenBtn:hover { background-color: #059669; }
QPushButton#SettingsAutomationOpenBtn:pressed { background-color: #047857; }
QPushButton#SettingsAutomationReloadBtn {
    background-color: #1f3a6e; color: #79c0ff; border: 1px solid #388bfd;
    padding: 8px 16px; border-radius: 6px; font-weight: bold;
}
QPushButton#SettingsAutomationReloadBtn:hover { background-color: #388bfd; color: #ffffff; }
QPushButton#SettingsAutomationReloadBtn:pressed { background-color: #1158c7; color: #ffffff; }
